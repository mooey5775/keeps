{
  "name": "keeps",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "test": "pnpm -r test",
    "test:strict": "pnpm -r test:strict",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @keeps/web build && pnpm --filter @keeps/server e2e",
    "dev": "pnpm --parallel --filter @keeps/server --filter @keeps/web dev",
    "start": "pnpm --filter @keeps/web build && pnpm --filter @keeps/server start"
  }
}
